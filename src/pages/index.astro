  <script is:inline>
    function bukaModal(src) {
      document.getElementById("modalGambar").style.display = "flex";
      document.getElementById("imgModal").src = src;
    }
    function tutupModal() {
      document.getElementById("modalGambar").style.display = "none";
    }

    document.querySelectorAll('nav a').forEach(link => {
      link.addEventListener('click', () => {
        document.getElementById("menu-toggle").checked = false;
      });
    });

    const dataLayanan = {
      pethotel: {
        judul: "🏨 Pet Hotel",
        deskripsi: "Layanan penitipan hewan peliharaan dengan fasilitas yang aman, bersih, dan nyaman serta pengawasan penuh selama 24 jam. Kami memastikan setiap hewan mendapat perhatian, kasih sayang, dan lingkungan yang menyenangkan selama ditinggal pemiliknya.",
        fitur: ["Kandang bersih & nyaman", "Pengawasan 24 jam", "Laporan kondisi hewan", "Tersedia untuk kucing, anjing, kelinci & hamster"],
        harga: [
          { paket: "1 Hari / 1 Malam", harga: "Rp 80.000" },
          { paket: "3 Hari / 2 Malam", harga: "Rp 210.000" },
          { paket: "7 Hari / 6 Malam", harga: "Rp 490.000" }
        ],
        foto: ["foto-pet-hotel1.jpg", "foto-pet-hotel2.jpg", "foto-pet-hotel3.jpg"]
      },
      grooming: {
        judul: "✂️ Grooming",
        deskripsi: "Perawatan kebersihan lengkap seperti mandi, potong kuku, pembersihan telinga, dan perawatan bulu agar anabul tetap sehat, rapi, dan wangi. Dilakukan oleh groomer berpengalaman yang sayang hewan.",
        fitur: ["Mandi & blow dry", "Potong kuku", "Bersih telinga", "Potong & rapikan bulu"],
        harga: [
          { paket: "Basic Grooming", harga: "Rp 70.000" },
          { paket: "Complete Grooming", harga: "Rp 120.000" },
          { paket: "Flea Treatment", harga: "Rp 150.000" }
        ],
        foto: ["foto-grooming1.jpg", "foto-grooming2.jpg", "foto-grooming3.jpg"]
      },
      dailycare: {
        judul: "🌟 Daily Care",
        deskripsi: "Layanan perawatan harian yang mencakup pemberian makan sesuai jadwal, sesi bermain, dan pemantauan kondisi kesehatan hewan dengan penuh perhatian. Cocok untuk hewan yang butuh perhatian rutin setiap hari.",
        fitur: ["Pemberian makan & minum", "Sesi bermain & interaksi", "Pemantauan kondisi kesehatan", "Update foto & laporan harian"],
        harga: [
          { paket: "Half Day (6 jam)", harga: "Rp 35.000" },
          { paket: "Full Day (12 jam)", harga: "Rp 55.000" }
        ],
        foto: ["foto-daily-care1.jpg", "foto-daily-care2.jpg", "foto-daily-care3.jpg"]
      }
    };

    function bukaModalLayanan(id) {
      const data = dataLayanan[id];
      if (!data) return;
      const fotoHTML = data.foto.map(f =>
        `<img src="${f}" alt="${data.judul}" class="modal-layanan-foto" onclick="bukaModal(this.src)">`
      ).join('');
      const fiturHTML = data.fitur.map(f => `<li>✓ ${f}</li>`).join('');
      document.getElementById("modalLayananKonten").innerHTML = `
        <h2 class="modal-layanan-judul">${data.judul}</h2>
        <p class="modal-layanan-desc">${data.deskripsi}</p>
        <ul class="modal-layanan-fitur">${fiturHTML}</ul>
        <div class="modal-layanan-galeri">${fotoHTML}</div>
        <a href="https://wa.me/6285691544401?text=Halo%20Anaboo%2C%20saya%20ingin%20tanya%20tentang%20${encodeURIComponent(data.judul.replace(/[^\w\s]/gi, '').trim())}!"
          class="btn btn-wa" target="_blank" style="margin-top:16px; display:inline-block;">
          Pesan via WhatsApp
        </a>
      `;
      document.getElementById("modalLayanan").style.display = "flex";
      document.body.style.overflow = "hidden";
    }

    function tutupModalLayanan(e) {
      document.getElementById("modalLayanan").style.display = "none";
      document.body.style.overflow = "";
    }

    function bukaModalHarga(id) {
      const data = dataLayanan[id];
      if (!data) return;
      const hargaHTML = data.harga.map(h => `
        <div class="harga-row">
          <span class="harga-paket">${h.paket}</span>
          <span class="harga-nominal">${h.harga}</span>
        </div>
      `).join('');
      document.getElementById("modalHargaKonten").innerHTML = `
        <h2 class="modal-layanan-judul">${data.judul} — Daftar Harga</h2>
        <div class="harga-box">
          ${hargaHTML}
        </div>
        <a href="https://wa.me/6285691544401?text=Halo%20Anaboo%2C%20saya%20ingin%20pesan%20${encodeURIComponent(data.judul.replace(/[^\w\s]/gi, '').trim())}!"
          class="btn btn-wa" target="_blank" style="margin-top:16px; display:inline-block;">
          Pesan via WhatsApp
        </a>
      `;
      document.getElementById("modalHarga").style.display = "flex";
      document.body.style.overflow = "hidden";
    }

    function tutupModalHarga(e) {
      document.getElementById("modalHarga").style.display = "none";
      document.body.style.overflow = "";
    }
  </script>

</body>
</html>
